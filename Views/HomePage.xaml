<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
    xmlns:models="clr-namespace:LifeManagementApp.Models"
    x:Class="LifeManagementApp.Views.HomePage"
    x:DataType="vm:HomeViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="3 Tärkeintä tehtävää"
                FontSize="24"
                FontAttributes="Bold" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                IsVisible="{Binding IsLoading}" />
            
            <CollectionView ItemsSource="{Binding TopThreeTodos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TodoItem">
                        <Grid ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto, Auto" Padding="8">
                        <Label Text="{Binding Title}" />
                        <Label Grid.Row="1"
                               Text="{Binding Priority}" />
                        <Label Grid.Column="1"
                               Grid.RowSpan="2"
                               Text="{Binding DueDate, StringFormat='{}{0:d}'}" />

                    </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding CurrentWeather.Temperature, StringFormat='{}{0:F1} °C'}" />
            <Label Text="{Binding CurrentWeather.WindSpeed, StringFormat='{}{0:F1} m/s'}" />
            <Label Text="{Binding KiteSurfAlert}" 
                    TextColor="Red">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                        Binding="{Binding KiteSurfAlert}"
                        Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers> 
            </Label>   
            

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>