<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
    xmlns:models="clr-namespace:LifeManagementApp.Models"
    x:Class="LifeManagementApp.Views.HomePage"
    x:DataType="vm:HomeViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource MainBackground}, Dark={StaticResource MainBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20" BackgroundColor="{AppThemeBinding Light={StaticResource MainBackground}, Dark={StaticResource MainBackgroundDark}}">

            <!-- Header 
            <Label Text="Dashboard"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                Margin="0,8,0,0" />-->

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="{AppThemeBinding Light={StaticResource PrimaryAccentLight}, Dark={StaticResource PrimaryAccentDark}}" />

            <!-- Top 3 Todos Card -->
            <Border Stroke="{AppThemeBinding Light={StaticResource PrimaryAccentLight}, Dark={StaticResource PrimaryAccentDark}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SecondarySurfaceLight}, Dark={StaticResource SecondarySurfaceDark}}"
                Padding="0">

                <VerticalStackLayout Padding="16" Spacing="12">
                    <Label Text="Tärkeimmät tehtävät"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryAccentLight}, Dark={StaticResource PrimaryAccentDark}}" />

                    <CollectionView ItemsSource="{Binding TopThreeTodos}" 
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TodoItem">
                                <VerticalStackLayout Padding="12,8" Spacing="4">
                                    <Border Stroke="{AppThemeBinding Light={StaticResource PrimaryAccentLight}, Dark={StaticResource PrimaryAccentDark}}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                        Padding="12">

                                        <Grid ColumnDefinitions="*,Auto" 
                                            RowDefinitions="Auto,Auto" 
                                            ColumnSpacing="8"
                                            RowSpacing="4">

                                            <Label Text="{Binding Title}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                                LineBreakMode="TailTruncation" />

                                            <Label Grid.Row="1"
                                                Text="{Binding Priority, StringFormat='Priority: {0}'}"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />

                                            <Label Grid.Column="1"
                                                Grid.RowSpan="2"
                                                Text="{Binding DueDate, StringFormat='{}{0:d}'}"
                                                FontSize="12"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Weather Card -->
            <Border Stroke="{AppThemeBinding Light={StaticResource SecondaryAccentLight}, Dark={StaticResource SecondaryAccentDark}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SecondarySurfaceLight}, Dark={StaticResource SecondarySurfaceDark}}"
                Padding="16">

                <VerticalStackLayout Spacing="12">
                    <Label Text="Sää"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryAccentLight}, Dark={StaticResource SecondaryAccentDark}}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="16">
                        <!-- Temperature -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Lämpötila"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                            <Label Text="{Binding CurrentWeather.Temperature, StringFormat='{}{0:F1} °C'}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </VerticalStackLayout>

                        <!-- Wind Speed -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Tuuli"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                            <Label Text="{Binding CurrentWeather.WindSpeed, StringFormat='{}{0:F1} m/s'}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </VerticalStackLayout>
                        
                        <!-- Location -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="12">
                            <Label Text="Sijainti" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryAccentLight}, Dark={StaticResource PrimaryAccentDark}}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Leveysaste" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight},Dark={StaticResource SecondaryTextDark}}"/>
                                    <Entry Text="{Binding LatitudeText}" Keyboard="Numeric" Placeholder="Esim 60.17" ClearButtonVisibility="WhileEditing"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Pituusaste" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"/>
                                    <Entry Text="{Binding LongitudeText}" Keyboard="Numeric" Placeholder="Esim 24.93" ClearButtonVisibility="WhileEditing"/>
                                </VerticalStackLayout>
                            </Grid>
                            <Button Text="Hae sää" Command="{Binding FetchWeatherCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"/>
                            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}, FallbackValue=False}" TextColor="Red" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- KiteSurf Alert Card -->
            <Border Stroke="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SecondarySurfaceLight}, Dark={StaticResource SecondarySurfaceDark}}"
                Padding="16">

                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                        Binding="{Binding KiteSurfAlert}"
                        Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Kite Surf Hälytys"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />

                    <Label Text="{Binding KiteSurfAlert}"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>