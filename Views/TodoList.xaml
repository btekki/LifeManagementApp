<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
    xmlns:models="clr-namespace:LifeManagementApp.Models"
    x:Class="LifeManagementApp.Views.TodoListPage"
    x:DataType="vm:TodoListViewModel"
    Title="Tehtävälista"
    BackgroundColor="{AppThemeBinding Light={StaticResource MainBackground}, Dark={StaticResource MainBackgroundDark}}">

    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <Button Grid.Row="0"
            Text="Lisää uusi tehtävä"
            Clicked="OnAddTodoClicked"
            BackgroundColor="{StaticResource PrimaryAccent}"
            TextColor="White" />

        <ActivityIndicator IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            Color="{AppThemeBinding Light={StaticResource PrimaryAccentLight}, Dark={StaticResource PrimaryAccentDark}}"
            Grid.Row="1" />

        <Border Grid.Row="2"
            Stroke="{AppThemeBinding Light={StaticResource SecondaryAccentLight}, Dark={StaticResource SecondaryAccentDark}}"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 12"
            BackgroundColor="{AppThemeBinding Light={StaticResource SecondarySurfaceLight}, Dark={StaticResource SecondarySurfaceDark}}"
            Padding="12">
            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween">
                <Button Text="Lajittele prioriteetin mukaan"
                    Command="{Binding SortByPriorityCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccentLight}, Dark={StaticResource PrimaryAccentDark}}"
                    TextColor="White"
                    Margin="0,0,8,8" />
                <Button Text="Lajittele eräpäivän mukaan"
                    Command="{Binding SortByDueDateCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryAccentLight}, Dark={StaticResource SecondaryAccentDark}}"
                    TextColor="White"
                    Margin="0,0,8,8" />
                <Button Text="{Binding ShowDoneButtonText}"
                    Command="{Binding ToggleShowDoneCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}"
                    TextColor="White"
                    Margin="0,0,8,8" />
            </FlexLayout>
        </Border>

        <CollectionView Grid.Row="3" ItemsSource="{Binding AllTodos}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Poista" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}},Path=DeleteTodoCommand}" CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Stroke="{AppThemeBinding Light={StaticResource BordersLight}, Dark={StaticResource BordersDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Padding="10"
                            Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" HorizontalOptions="Fill" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" LineBreakMode="WordWrap">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="16" VerticalOptions="Center">
                                    <Border Stroke="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}" StrokeThickness="2" StrokeShape="RoundRectangle 8" Padding="8,4">
                                        <Label Text="{Binding Priority, StringFormat='Prioriteetti: {0}'}" FontSize="15" FontAttributes="Bold" TextColor="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding DueDate, StringFormat='Eräpäivä: {0:d}'}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                                    <Button Text="Valmis" Clicked="OnToggleDoneClicked" Padding="10,4" FontSize="12" HeightRequest="38" MinimumWidthRequest="78" BackgroundColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" TextColor="White">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Text" Value="Kumoa" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button Text="Muokkaa" Clicked="OnEditTodoClicked" Padding="8,3" FontSize="12" HeightRequest="34" MinimumWidthRequest="78" BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryAccentLight}, Dark={StaticResource SecondaryAccentDark}}" TextColor="White" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>           


