<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
    x:Class="LifeManagementApp.Views.AddTodoPage"
    x:DataType="vm:AddTodoViewModel"
    Title="Lisää tehtävä"
    BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <!-- Form Container -->
            <Border Style="{StaticResource ContainerStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Tehtävän tiedot" Style="{StaticResource SubheadingLabelStyle}" />

                    <Entry Placeholder="Otsikko" 
                           Keyboard="Text" 
                           Text="{Binding Title}"
                           Style="{StaticResource InputEntryStyle}" />

                    <!-- Priority Container -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Priority, StringFormat='Prioriteetti: {0}'}" 
                                   Style="{StaticResource BodyLabelStyle}" />
                            <Stepper Minimum="1" Maximum="5" Increment="1" Value="{Binding Priority}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Due Date Container -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="Aseta eräpäivä" 
                                       VerticalOptions="Center"
                                       Style="{StaticResource BodyLabelStyle}" />
                                <Switch IsToggled="{Binding HasDueDate}" />
                            </HorizontalStackLayout>
                            <DatePicker Date="{Binding DueDatePickerDate}" IsEnabled="{Binding HasDueDate}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Error Message Container -->
            <Border Style="{StaticResource ContainerStyle}">
                <Label Text="{Binding ErrorMessage}" 
                       TextColor="{StaticResource ErrorColor}"
                       Style="{StaticResource BodyLabelStyle}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" 
                                     Binding="{Binding ErrorMessage}" 
                                     Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>

            <!-- Action Buttons Container -->
            <Border Style="{StaticResource ContainerStyle}">
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Tallenna" 
                            Command="{Binding SaveTodoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalOptions="FillAndExpand" />
                    <Button Text="Peruuta" 
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalOptions="FillAndExpand" />
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>