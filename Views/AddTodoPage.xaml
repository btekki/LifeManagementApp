<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
    x:Class="LifeManagementApp.Views.AddTodoPage"
    x:DataType="vm:AddTodoViewModel"
    Title="Add todo">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Entry Placeholder="Title" Keyboard="Text" Text="{Binding Title}" />
        <Label Text="{Binding Priority, StringFormat='Priority: {0}'}" />
        <Stepper Minimun="1" Maximum="5" Increment="1" Value="{Binding Priority}" />

        <HorizontalStackLayout Spacing="12">
            <Label Text="Aseta eräpäivä" VerticalOptions="Center" />
            <Switch IsToggled="{Binding HasDueDate}" />
        </HorizontalStackLayout>

        <DatePicker Date="{Binding DueDatePickerDate}" IsEnabled="{Binding HasDueDate}" />
        <Label Text="{Binding ErrorMessage}" TextColor="Red">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding ErrorMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Button Text="Tallenna" Command="{Binding SaveTodoCommand}" />
        <Button Text="Peruuta" Command="{Binding CancelCommand}" />

    </VerticalStackLayout>
</ContentPage>