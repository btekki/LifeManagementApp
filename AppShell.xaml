<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LifeManagementApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LifeManagementApp"
    xmlns:views="clr-namespace:LifeManagementApp.Views"
    Title="LifeManagementApp"
    FlyoutBehavior="Disabled">

    <TabBar>

        <ShellContent
            Title="Koti"
            Icon="home.png"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="Home" />

        <ShellContent
            Title="Tehtävälista"
            Icon="list.png"
            ContentTemplate="{DataTemplate views:TodoListPage}"
            Route="TodoList" />

        <ShellContent
            Title="Lisää tehtävä"
            Icon="add.png"
            ContentTemplate="{DataTemplate views:AddTodoPage}"
            Route="AddTodo" />

    </TabBar>
</Shell>
