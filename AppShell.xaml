<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LifeManagementApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LifeManagementApp"
    xmlns:views="clr-namespace:LifeManagementApp.Views"
    Title="LifeManagementApp"
    FlyoutBehavior="Disabled"
    x:Name="AppShellRoot"
    BackgroundColor="{AppThemeBinding Light={StaticResource MainBackgroundLight}, Dark={StaticResource MainBackgroundDark}}"
    TitleColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
    TabBarBackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
    TabBarTitleColor="{AppThemeBinding Light={StaticResource PrimaryAccentLight}, Dark={StaticResource PrimaryAccentDark}}"
    TabBarUnselectedColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}">

    <Shell.ToolbarItems>
        <ToolbarItem Text="Light"
            Command="{Binding Source={x:Reference AppShellRoot}, Path=LightModeCommand}"
            Order="Primary" />
        <ToolbarItem Text="Dark"
            Command="{Binding Source={x:Reference AppShellRoot}, Path=DarkModeCommand}"
            Order="Primary" />
    </Shell.ToolbarItems>

    <TabBar>

        <ShellContent
            Title="Koti"
            Icon="home.png"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="Home" />

        <ShellContent
            Title="Tehtävälista"
            Icon="list.png"
            ContentTemplate="{DataTemplate views:TodoListPage}"
            Route="TodoList" />

        <ShellContent
            Title="Lisää tehtävä"
            Icon="add.png"
            ContentTemplate="{DataTemplate views:AddTodoPage}"
            Route="AddTodo" />

    </TabBar>
</Shell>
