<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LifeManagementApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LifeManagementApp"
    Title="LifeManagementApp">
    FlyoutBehavior="Disabled"

    <TabBar>

        <ShellContent
            Title="Home"
            Icon="home.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="Home" />

        <ShellContent
            Title="Todo List"
            Icon="list.png"
            ContentTemplate="{DataTemplate local:TodoListPage}"
            Route="TodoList" />

        <ShellContent
            Title="Add Todo"
            Icon="add.png"
            ContentTemplate="{DataTemplate local:AddTodoPage}"
            Route="AddTodo" />

    </TabBar>
</Shell>
