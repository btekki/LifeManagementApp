<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LifeManagementApp"
             xmlns:converters="clr-namespace:LifeManagementApp.Converters"
             x:Class="LifeManagementApp.App">
    <Application.Resources>
        <ResourceDictionary x:Name="MainResourceDictionary">
            <converters:PriorityToColorConverter x:Key="PriorityToColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/lightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Dark Theme Resources will be loaded dynamically by ThemeService -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
