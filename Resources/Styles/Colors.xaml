<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Light Mode Colors -->
    <Color x:Key="MainBackgroundLight">#F8FAFC</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SecondarySurfaceLight">#F1F5F9</Color>
    <Color x:Key="BordersLight">#E2E8F0</Color>
    <Color x:Key="PrimaryTextLight">#0F172A</Color>
    <Color x:Key="SecondaryTextLight">#475569</Color>
    <Color x:Key="PrimaryAccentLight">#2563EB</Color>
    <Color x:Key="SecondaryAccentLight">#0EA5E9</Color>
    <Color x:Key="SuccessLight">#059669</Color>
    <Color x:Key="WarningLight">#D97706</Color>
    <Color x:Key="ErrorLight">#DC2626</Color>

    <!-- Dark Mode Colors -->
    <Color x:Key="MainBackgroundDark">#0B1120</Color>
    <Color x:Key="SurfaceDark">#111827</Color>
    <Color x:Key="SecondarySurfaceDark">#1E293B</Color>
    <Color x:Key="BordersDark">#334155</Color>
    <Color x:Key="PrimaryTextDark">#F8FAFC</Color>
    <Color x:Key="SecondaryTextDark">#94A3B8</Color>
    <Color x:Key="PrimaryAccentDark">#3B82F6</Color>
    <Color x:Key="SecondaryAccentDark">#0EA5E9</Color>
    <Color x:Key="SuccessDark">#10B981</Color>
    <Color x:Key="WarningDark">#F59E0B</Color>
    <Color x:Key="ErrorDark">#F87171</Color>

    <!-- Semantic Color Aliases (used throughout app) -->
    <Color x:Key="MainBackground">#F8FAFC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SecondarySurface">#F1F5F9</Color>
    <Color x:Key="Borders">#E2E8F0</Color>
    <Color x:Key="PrimaryText">#0F172A</Color>
    <Color x:Key="SecondaryText">#475569</Color>
    <Color x:Key="PrimaryAccent">#2563EB</Color>
    <Color x:Key="SecondaryAccent">#0EA5E9</Color>
    <Color x:Key="Success">#059669</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="Error">#DC2626</Color>

    <!-- Brush Definitions -->
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="{StaticResource MainBackground}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource SecondarySurface}"/>
    <SolidColorBrush x:Key="BordersBrush" Color="{StaticResource Borders}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccent}"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccent}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
</ResourceDictionary>